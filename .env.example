# teamem portal — deployment environment (copy to .env and fill in)

# ── Required ─────────────────────────────────────────────────────────────
# No default on purpose: compose refuses to start without it.
POSTGRES_PASSWORD=

# ── Optional (defaults shown) ────────────────────────────────────────────
POSTGRES_USER=teamem
POSTGRES_DB=teamem

# Host port bound for the Postgres container (loopback-only, defaults to 5432).
TEAMEM_PG_PORT=5432
# Host port the portal is published on (container listens on 8080).
TEAMEM_PORT=8080

# Public base URL for OAuth redirect URI construction.
# Defaults to http://localhost:${TEAMEM_PORT} when not set.
# Set this to your actual host if deploying behind a reverse proxy or tunnel
# (e.g. https://teamem.example.com or https://abc123.ngrok-free.app).
TEAMEM_BASE_URL=

# Single-process mode: server embeds the compile worker.
# When true, bring up only postgres+server:
#   TEAMEM_ALL_IN_ONE=true docker compose up -d postgres server
TEAMEM_ALL_IN_ONE=false

# ── GitHub App (single App for OAuth login + webhook ingestion) ──────────
# Create ONE GitHub App before the first docker compose up. All values below
# come from the same App's settings page.
#
# The App must have:
#   - OAuth enabled (used for user login — "GitHub App 是否已完整配置")
#   - Webhook active with a secret (used to verify incoming GitHub events)
#   - Private key downloaded (used to sign App-authenticated API calls)
#   - At least one installation (org/user — Installation ID listed there)
#
# The Client ID and Client Secret are found under the App's "Client ID"
# and "Client secrets" sections (same page as the App ID).
# See: https://docs.github.com/en/apps/creating-github-apps

# Webhook secret used to verify incoming GitHub events.
TEAMEM_GITHUB_WEBHOOK_SECRET=
# GitHub App numeric ID (from the app's settings page).
TEAMEM_GITHUB_APP_ID=
# Installation ID for the target org/user (from the app's install page).
TEAMEM_GITHUB_INSTALLATION_ID=
# RSA private key (PEM) for signing GitHub App JWTs.
# Use the key downloaded when the App was created.
TEAMEM_GITHUB_PRIVATE_KEY=
# OAuth Client ID from the SAME GitHub App (for user login via GitHub).
TEAMEM_GITHUB_OAUTH_CLIENT_ID=
# OAuth Client Secret from the SAME GitHub App (for user login via GitHub).
# Generate one under "Client secrets" in the App settings.
TEAMEM_GITHUB_OAUTH_CLIENT_SECRET=

# ── LLM provider keys (BYO — bring your own key) ─────────────────────────
# M0 reads these from env; M2 moves provider config into the portal UI.
# TEAMEM_-prefixed on purpose so the ambient ANTHROPIC_API_KEY /
# OPENAI_API_KEY of the host shell are never inherited by accident.
# Configure at least one provider for compilation to run.
TEAMEM_ANTHROPIC_API_KEY=
TEAMEM_OPENAI_API_KEY=
TEAMEM_OPENROUTER_API_KEY=

# Any OpenAI-compatible endpoint (DeepSeek, LM Studio, internal gateway) —
# for teams that need LLM calls to stay inside their network.
TEAMEM_OPENAI_COMPAT_BASE_URL=
TEAMEM_OPENAI_COMPAT_API_KEY=

# ── LLM key encryption (M2 UI) ───────────────────────────────────────────
# 64-character hex string (32 bytes) used to AES-256-GCM encrypt the
# BYO LLM provider keys stored in the database. Required to use the LLM
# configuration panel in the web UI. Generate with:
#   openssl rand -hex 32
TEAMEM_LLM_ENCRYPTION_KEY=

# ── Diagnostics (optional) ───────────────────────────────────────────────
# Debug compile failures: log the underlying cause of an LLM failure —
# schema_validation_failed, output_truncated, timeout, provider_error, or
# http_error — to the worker log, including the provider's finish_reason and a
# secret-scrubbed snippet of the response, so an otherwise-opaque "f1_*" job
# error can be investigated. See README "Troubleshooting" for the codes.
# 1 = on, blank = off. Keep it OFF (blank) in production; enable only while
# debugging. Read by both server and worker; takes effect after a restart:
#   docker compose up -d --build
TEAMEM_LLM_DEBUG=
